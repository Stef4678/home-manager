# Build output
dist/

# Generated by the preview harness (regenerate with tools/render-previews.ps1)
tools/preview/app/
tools/preview/shots/

# Throwaway browser profiles and logs from the headless harness
tools/.chrome*/
tools/chrome-out.txt
tools/chrome-err.txt
tools/.npm-cache/

# Eagle's own "Pack Plugin" output is bloated (it zips this whole folder).
# Anything it drops here is a build artefact, not a source file.
*.eagleplugin
*.eagleplugin.zip

node_modules/
